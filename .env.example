# Copy to .env for local use. The mock provider needs zero credentials, and the
# gates (pytest, ruff) are designed to pass with everything here left empty.
ENVIRONMENT=local
LOG_LEVEL=INFO

# Warehouse. COPILOT_DB_URL is the owner connection used only by
# warehouse/provision.py to create the schema, the seed data and the read-only
# role. COPILOT_RO_URL is what the app itself connects with; provision.py prints
# it once the role exists. The app refuses to start if it is handed the owner
# URL instead.
COPILOT_DB_URL=
COPILOT_RO_URL=

# Model route. Tollgate is OpenAI-compatible; the mock provider streams canned
# responses and needs neither Tollgate nor a key.
COPILOT_LLM_PROVIDER=tollgate
TOLLGATE_URL=http://127.0.0.1:8077/v1
COPILOT_MODEL=groq/llama-3.3-70b-versatile

# Execution caps. The read-only role carries its own defaults; these bound a
# single request from the application side.
COPILOT_STATEMENT_TIMEOUT_MS=5000
COPILOT_ROW_CAP=500

# OpenTelemetry. Leave blank to disable exporting entirely.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
